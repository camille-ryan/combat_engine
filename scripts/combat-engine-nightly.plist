<?xml version="1.0" encoding="UTF-8"?>
<!--
  The nightly wide sweep. Install once:

      cp scripts/combat-engine-nightly.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/combat-engine-nightly.plist

  Check it is loaded:   launchctl print gui/$UID/com.combat-engine.nightly
  Run it now:           launchctl kickstart -p gui/$UID/com.combat-engine.nightly
  Remove it:            launchctl bootout gui/$UID/com.combat-engine.nightly

  02:07 rather than 02:00 on purpose: nothing else wants that minute, and a
  round hour is where every scheduled job on the machine lands at once.

  `RunAtLoad` is false — installing it should not start a 43-minute sweep.
  stdout and stderr go to logs/, which is git-ignored, and `nightly.sh` writes
  its own dated log besides.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.combat-engine.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/camille/proj/combat_engine/scripts/nightly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/camille/proj/combat_engine</string>

    <!-- **An interval, not a calendar time, because a calendar time does not
         survive a closed lid.** `StartCalendarInterval` fires at the named
         instant only if the machine is awake; asleep, launchd defers it to
         the next wake, and if there is no wake it is dropped. Measured over
         seventeen nights: three produced no attempt at all, and every
         on-time run was stamped `0307` while the outliers (`0320`, `0315`,
         `0218`, `0219`) are deferred firings. #871.

         It also settles a discrepancy nobody had: this said Hour 2 Minute 7
         and the logs said 03:07, which the root `CLAUDE.md` records as a
         fact without explaining. An interval has no hour to disagree about.

         Hourly, with `nightly.sh` deciding whether it is *due* — so the
         cost of a wrong hour is one `date` call, and the sweep still only
         runs overnight unless it is badly overdue. See `_due` there. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/camille/proj/combat_engine/logs/launchd-nightly.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/camille/proj/combat_engine/logs/launchd-nightly.err</string>

    <!-- `uv` lives in ~/.local/bin, which a launchd job does not inherit. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/camille/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
